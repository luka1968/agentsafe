# agentSAFE MCP Server (not the audit worker!)
# This container runs the FastMCP server that accepts audit requests and dispatches to GitHub Actions.
# Secrets are injected via environment variables at runtime.

FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PORT=8000 \
    HOST=0.0.0.0

RUN apt-get update \
    && apt-get install -y --no-install-recommends curl ca-certificates \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Build provenance: the publishing workflow passes the commit SHA so the
# landing-page footer can show exactly which build is live (the footer used
# to read VERCEL_GIT_COMMIT_SHA and therefore always showed "dev" on Docker
# hosts, which made "did the redeploy take effect?" impossible to answer).
ARG GIT_SHA=
ENV AGENTSAFE_GIT_SHA=${GIT_SHA}

COPY pyproject.toml ./
COPY src ./src

# Editable install ON PURPOSE: server.py resolves its runtime assets
# (openapi.json, favicon.ico, logo.png, web/dist/*.js) from
# Path(__file__).parents[2]. With an editable install that resolves to /app
# (the app root); with a regular install the package lands in site-packages
# and every one of those endpoints would 404.
RUN pip install --no-cache-dir -e . "x402[evm]==2.25.0"

# Runtime assets served by the ASGI app, resolved relative to /app.
COPY openapi.json favicon.ico logo.png ./
COPY web/dist ./web/dist

# Create data directory for SQLite persistence
RUN mkdir -p /app/data && chown -R root:root /app/data

# Healthcheck: the landing page is a cheap route that always answers 200.
# The MCP endpoint itself needs a session and answers 400 to a bare GET.
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD curl -f http://localhost:8000/ || exit 1

EXPOSE 8000

# NOTE: do NOT use "fastmcp run agentsafe.server:create_app". FastMCP 4.x's CLI
# resolves that argument as a FILE PATH (a "file.py:object" spec), so it looks
# for /app/agentsafe.server, logs "File not found" and exits 1. The package's
# own entry point (src/agentsafe/__main__.py -> server.main()) is used instead.
CMD ["python", "-m", "agentsafe", "--transport", "http", "--host", "0.0.0.0", "--port", "8000"]
