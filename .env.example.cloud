# agentSAFE MCP - Cloud Deployment (Prefect Horizon)
# Copy to your Prefect Environment Variables configuration
# DO NOT commit real secrets to version control

# --- Ethereum Mainnet RPC (Infura, Alchemy, or QuickNode) ---
INFURA_ETH_ENDPOINT=https://mainnet.infura.io/v3/<your-infura-project-id>
ETHERSCAN_API_KEY=<your-etherscan-api-key>

# --- LLM Providers (OpenAI-compatible API endpoints) ---
# Production example with multiple providers for redundancy
LLM_PROVIDERS_JSON=[{"name":"nvidia","base_url":"https://integrate.api.nvidia.com/v1","api_key":"<nvidia-api-key>","model":"meta/llama3-70b-instruct","rpm_limit":40},{"name":"groq","base_url":"https://api.groq.com/openai/v1","api_key":"<groq-api-key>","model":"llama-3.1-8b-instant","rpm_limit":60}]
LLM_GLOBAL_RPM=20
LLM_MAX_CALLS_PER_AUDIT=12
LLM_MAX_RETRIES_PER_CALL=3
LLM_REQUEST_TIMEOUT_SECONDS=90
LLM_MAX_OUTPUT_TOKENS=3000

# --- GitHub Actions Worker (for Docker container audits) ---
GITHUB_TOKEN=ghp_<your-personal-access-token>
GITHUB_REPO=luka1968/agentsafe
GITHUB_WORKFLOW_FILE=docker-audit.yml
GITHUB_REF=main
GITHUB_API_TIMEOUT_SECONDS=20
GITHUB_POLL_INTERVAL_SECONDS=10
AUDIT_TIMEOUT_SECONDS=900
MAX_CONCURRENT_AUDITS=3

# --- Artifact Policy ---
ARTIFACT_RETENTION_DAYS=7

# --- Task Persistence ---
# Local/Docker (Prefect Horizon): sqlite with a persistent volume.
# Vercel serverless: set TASK_STORE=redis (or leave TASK_STORE empty - it
# auto-selects redis when a Redis URL is detected). Vercel's Upstash
# integration injects REDIS_URL / REDIS_HOST+REDIS_PORT+REDIS_PASSWORD
# automatically; rediss:// TLS is supported natively.
# NOTE: REST credentials (UPSTASH_REDIS_REST_*) cannot drive the TCP client;
# use the connection-string vars.
TASK_STORE=redis
# REDIS_URL=rediss://default:<password>@<upstash-host>:6379
TASK_DB_PATH=/app/data/tasks.db

# --- Payments (Base Mainnet - PRODUCTION) ---
# Enable after successful Base Sepolia testnet testing
PAYMENTS_ENABLED=true
X402_NETWORK=eip155:8453
X402_PAY_TO=0x03ee35B45382d19b7BDcE1A2B1eD72Aae01c48cc
X402_SDK_VERSION=2.25.0
X402_FACILITATOR_URL=https://facilitator.payai.network
X402_PRICE=$0.50
X402_ASSET=
X402_MAX_TIMEOUT_SECONDS=300
# Flat fee for the x402 REST discovery endpoint POST /api/audit
# (indexed by x402scan via openapi.json; capped at 500 source lines).
X402_REST_PRICE=$3.00
# ⚠️ WARNING: Only enable after passing all e2e tests on testnet
X402_ALLOW_MAINNET=true

# --- Logging (production level) ---
LOG_LEVEL=WARNING

# --- Security Headers (optional but recommended) ---
CORS_ORIGINS=https://horizon.prefect.io,https://app.prefect.io
# NOTE: RATE_LIMIT_REQUESTS/RATE_LIMIT_WINDOW are legacy placeholders (unused);
# the enforced limiter is HTTP_RATE_LIMIT_PER_MINUTE below.
# RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60

# --- Stage 11 HTTP hardening ---
# Per-client-IP rate limit on REST endpoints (POST /api/audit, report GETs).
# MCP tool calls are NOT HTTP and are never limited by this.
HTTP_RATE_LIMIT_PER_MINUTE=20
# Max request body size in bytes for the audit endpoint (defends against
# oversized-body memory abuse; audit bodies are tiny JSON objects).
HTTP_MAX_BODY_BYTES=262144
# Optional JSONL sink for aggregate operational metrics (counters + durations
# only; NEVER payloads, addresses, task ids, or source code).
METRICS_JSONL_PATH=/tmp/agentsafe_metrics.jsonl
