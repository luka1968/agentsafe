# agentSAFE MCP - environment configuration
# Copy to .env and fill in real values. NEVER commit .env or real secrets.

# --- Ethereum Mainnet RPC (Infura or any JSON-RPC 2.0 endpoint) ---
INFURA_ETH_ENDPOINT=
ETHERSCAN_API_KEY=

# --- LLM providers (OpenAI-compatible) ---
# JSON array; each item: {"name","base_url","api_key","model","rpm_limit"}
# Deploy-time: verify actual endpoints, model IDs, quotas and rate limits.
LLM_PROVIDERS_JSON=[]
LLM_GLOBAL_RPM=10
LLM_MAX_CALLS_PER_AUDIT=12
LLM_MAX_RETRIES_PER_CALL=2
LLM_REQUEST_TIMEOUT_SECONDS=90
LLM_MAX_OUTPUT_TOKENS=3000

# --- GitHub Actions worker dispatch ---
GITHUB_TOKEN=
GITHUB_REPO=owner/repo
GITHUB_WORKFLOW_FILE=audit.yml
GITHUB_REF=main
GITHUB_API_TIMEOUT_SECONDS=20
GITHUB_POLL_INTERVAL_SECONDS=10
AUDIT_TIMEOUT_SECONDS=900
MAX_CONCURRENT_AUDITS=1

# --- Artifact policy ---
ARTIFACT_RETENTION_DAYS=2

# --- Task persistence: sqlite (durable) or memory (restart = GitHub rebuild) ---
TASK_STORE=sqlite
TASK_DB_PATH=data/tasks.db

# --- Payments (development default: disabled) ---
# PAYMENTS_ENABLED=true additionally requires: `pip install x402[evm]==2.25.0`
# (the pinned SDK version recorded in X402_SDK_VERSION) and a funded payer.
# Integration testing MUST run on Base Sepolia testnet first; mainnet
# (eip155:8453) additionally requires X402_ALLOW_MAINNET=true and is only
# meant to be enabled after end-to-end tests pass on testnet.
PAYMENTS_ENABLED=false
# Base Sepolia testnet (CAIP-2). Default asset = test USDC from the
# facilitator's /supported response for this network.
X402_NETWORK=eip155:84532
X402_PAY_TO=
X402_SDK_VERSION=2.25.0
# --- Optional second payment channel: Creem card checkout (Merchant of Record) ---
# Independent of x402. When CREEM_ENABLED=true the web UI shows a "Pay by card"
# button; the ONLY trusted payment confirmation is the signed webhook
# (HMAC-SHA256, creem-signature header) at /api/pay/creem/webhook.
# Register that URL in the Creem dashboard (Developers > Webhooks) and put the
# signing secret here. Test keys (creem_test_*) need CREEM_API_BASE=https://test-api.creem.io
# CREEM_ENABLED=false
# CREEM_API_KEY=
# CREEM_WEBHOOK_SECRET=
# CREEM_PRODUCT_ID=
# CREEM_API_BASE=https://api.creem.io
# Official facilitator (supports Base + Base Sepolia).
X402_FACILITATOR_URL=https://x402.org/facilitator
# Audit pricing is TIERED by verified source size (see src/agentsafe/pricing.py):
#   <=100 lines $0.50 | <=500 $2.50 | <=1000 $5.00 | <=5000 $25.00 | larger: custom.
# X402_PRICE is only the fallback/base requirement built at startup (and the
# price used when no dynamic quote applies); the advertised 402 amount for
# audit_contract always comes from the size tier.
X402_PRICE=$0.01
# Optional asset override (contract address); empty = facilitator default
# (test USDC on Base Sepolia).
X402_ASSET=
X402_MAX_TIMEOUT_SECONDS=300
# Mainnet (eip155:8453) requires this explicit opt-in AND passing e2e tests.
X402_ALLOW_MAINNET=false

# --- Security Knowledge Base (Neon PostgreSQL + pgvector) ---
# The production KB. When NEON_DATABASE_URL is set AND an embedder is
# configured, retrieval is HYBRID (pgvector cosine + PostgreSQL full-text,
# fused with RRF). Without either, the runtime SILENTLY falls back to the
# shipped in-repo JSONL KB (dataset/v1.jsonl — a small curated set,
# lexical-only). Set both so audits use the full Neon KB with 2048-d vectors.
NEON_DATABASE_URL=
# '' auto-selects 'neon' when NEON_DATABASE_URL is present, else 'jsonl'.
KB_STORAGE=
# MUST match the stored vector dimension (2048 for nemotron-3.5-embed-1b).
KB_VECTOR_DIM=2048

# --- Embeddings (NVIDIA NIM; OpenAI-compatible) ---
# Required for the vector retrieval leg. Without it the Neon KB is used
# lexical-only (still better than the JSONL fallback, but not hybrid).
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_EMBED_MODEL=nvidia/nemotron-3.5-embed-1b
EMBED_DIM=2048

# --- Logging ---
LOG_LEVEL=INFO
