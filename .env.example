# agentSAFE MCP - environment configuration
# Copy to .env and fill in real values. NEVER commit .env or real secrets.

# --- Ethereum Mainnet RPC (Infura or any JSON-RPC 2.0 endpoint) ---
INFURA_ETH_ENDPOINT=
ETHERSCAN_API_KEY=

# --- LLM providers (OpenAI-compatible) ---
# JSON array; each item: {"name","base_url","api_key","model","rpm_limit"}
# Deploy-time: verify actual endpoints, model IDs, quotas and rate limits.
LLM_PROVIDERS_JSON=[]
LLM_GLOBAL_RPM=10
LLM_MAX_CALLS_PER_AUDIT=12
LLM_MAX_RETRIES_PER_CALL=2
LLM_REQUEST_TIMEOUT_SECONDS=90
LLM_MAX_OUTPUT_TOKENS=3000

# --- GitHub Actions worker dispatch ---
GITHUB_TOKEN=
GITHUB_REPO=owner/repo
GITHUB_WORKFLOW_FILE=audit.yml
GITHUB_REF=main
GITHUB_API_TIMEOUT_SECONDS=20
GITHUB_POLL_INTERVAL_SECONDS=10
AUDIT_TIMEOUT_SECONDS=900
MAX_CONCURRENT_AUDITS=1

# --- Artifact policy ---
ARTIFACT_RETENTION_DAYS=2

# --- Task persistence: sqlite (durable) or memory (restart = GitHub rebuild) ---
TASK_STORE=sqlite
TASK_DB_PATH=data/tasks.db

# --- Payments (development default: disabled) ---
# PAYMENTS_ENABLED=true additionally requires: `pip install x402[evm]==2.25.0`
# (the pinned SDK version recorded in X402_SDK_VERSION) and a funded payer.
# Integration testing MUST run on Base Sepolia testnet first; mainnet
# (eip155:8453) additionally requires X402_ALLOW_MAINNET=true and is only
# meant to be enabled after end-to-end tests pass on testnet.
PAYMENTS_ENABLED=false
# Base Sepolia testnet (CAIP-2). Default asset = test USDC from the
# facilitator's /supported response for this network.
X402_NETWORK=eip155:84532
X402_PAY_TO=
X402_SDK_VERSION=2.25.0
# Official facilitator (supports Base + Base Sepolia).
X402_FACILITATOR_URL=https://x402.org/facilitator
# Price per audit, USD (testnet: use a tiny value while testing).
X402_PRICE=$0.01
# Optional asset override (contract address); empty = facilitator default
# (test USDC on Base Sepolia).
X402_ASSET=
X402_MAX_TIMEOUT_SECONDS=300
# Mainnet (eip155:8453) requires this explicit opt-in AND passing e2e tests.
X402_ALLOW_MAINNET=false

# --- Logging ---
LOG_LEVEL=INFO
